<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ቢንጎ ፕሮ ሚኒ አፕ</title>
    <script src="https://telegram.org"></script>
    <style>
        :root {
            --bg: #0f172a;
            --card: #1e293b;
            --primary: #f59e0b;
            --accent: #10b981;
            --danger: #ef4444;
            --text: #f8fafc;
            --muted: #94a3b8;
            --cell: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, sans-serif;
            user-select: none;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 12px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 400px;
            background: var(--card);
            padding: 10px 14px;
            border-radius: 14px;
            margin-bottom: 10px;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .user-name { font-size: 0.9rem; font-weight: bold; }
        .wallet-badge { font-size: 0.9rem; color: var(--accent); font-weight: bold; margin-top: 2px; }

        .wallet-actions {
            display: flex;
            gap: 6px;
        }

        .btn-sm {
            padding: 7px 10px;
            border: none;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
            color: #fff;
        }

        .btn-dep { background: var(--accent); }
        .btn-with { background: #3b82f6; }

        .bet-panel {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 400px;
            background: var(--card);
            padding: 8px 12px;
            border-radius: 12px;
            margin-bottom: 10px;
        }

        .bet-panel span { font-size: 0.85rem; color: var(--muted); }
        .bet-options { display: flex; gap: 6px; }

        .bet-chip {
            background: var(--cell);
            color: var(--text);
            border: 1px solid transparent;
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: bold;
            cursor: pointer;
        }

        .bet-chip.active {
            background: rgba(245, 158, 11, 0.2);
            border-color: var(--primary);
            color: var(--primary);
        }

        .caller-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 400px;
            background: var(--card);
            padding: 10px 14px;
            border-radius: 14px;
            margin-bottom: 10px;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .current-ball {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #fbbf24, #d97706);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 900;
        }

        .history-section { flex: 1; margin-left: 12px; }
        .history-label { font-size: 0.75rem; color: var(--muted); margin-bottom: 5px; }
        .history-balls { display: flex; gap: 5px; flex-wrap: wrap; }
        .mini-ball { background: var(--cell); padding: 3px 7px; border-radius: 6px; font-size: 0.78rem; font-weight: bold; }

        .board {
            background: var(--card);
            padding: 12px;
            border-radius: 16px;
            width: 100%;
            max-width: 400px;
        }

        .board-header {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 8px;
            text-align: center;
        }

        .board-header div { font-size: 1.3rem; font-weight: 900; color: var(--primary); }

        .grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }

        .cell {
            aspect-ratio: 1 / 1;
            background: var(--cell);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            font-weight: bold;
            cursor: pointer;
        }

        .cell.marked { background: var(--primary); color: #000; }
        .cell.free { background: var(--accent); color: #fff; font-size: 0.85rem; }

        .controls {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            width: 100%;
            max-width: 400px;
            margin-top: 12px;
        }

        .btn {
            padding: 12px;
            border: none;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: bold;
            cursor: pointer;
            color: #fff;
        }

        .btn-auto { background: #2563eb; }
        .btn-auto.running { background: var(--danger); }
        .btn-new { background: var(--cell); }
        .btn-bingo {
            background: var(--accent);
            grid-column: span 2;
            font-size: 1.1rem;
        }

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.85);
            align-items: center;
            justify-content: center;
            z-index: 50;
            padding: 16px;
        }

        .modal-box {
            background: var(--card);
            padding: 22px;
            border-radius: 18px;
            width: 100%;
            max-width: 340px;
            border: 1px solid rgba(255,255,255,0.15);
            text-align: center;
        }

        .modal-box h3 { color: var(--primary); margin-bottom: 12px; font-size: 1.3rem; }
        .modal-box p { color: var(--text); margin-bottom: 15px; font-size: 0.95rem; }

        input, select {
            width: 100%;
            padding: 11px;
            margin-bottom: 12px;
            border-radius: 10px;
            border: 1px solid #475569;
            background: var(--bg);
            color: #fff;
            font-size: 1rem;
        }

        .modal-btns { display: flex; gap: 8px; }
        .modal-btns button { flex: 1; }
    </style>
</head>
<body>

    <div class="top-bar">
        <div>
            <div class="user-name" id="player-name">👤 ተጫዋች</div>
            <div class="wallet-badge">💰 ሂሳብ: <span id="balance">0</span> ብር</div>
        </div>
        <div class="wallet-actions">
            <button class="btn-sm btn-dep" onclick="openDeposit()">➕ አስገባ</button>
            <button class="btn-sm btn-with" onclick="openWithdraw()">➖ አውጣ</button>
        </div>
    </div>

    <div class="bet-panel">
        <span>ውርርድ ምረጥ:</span>
        <div class="bet-options">
            <button class="bet-chip active" onclick="setBet(10, this)">10 ብር</button>
            <button class="bet-chip" onclick="setBet(50, this)">50 ብር</button>
            <button class="bet-chip" onclick="setBet(100, this)">100 ብር</button>
        </div>
    </div>

    <div class="caller-box">
        <div class="current-ball" id="current-ball">--</div>
        <div class="history-section">
            <div class="history-label">የመጨረሻ 5 የተጠሩ ቁጥሮች:</div>
            <div class="history-balls" id="history-balls"></div>
        </div>
    </div>

    <div class="board">
        <div class="board-header">
            <div>B</div><div>I</div><div>N</div><div>G</div><div>O</div>
        </div>
        <div class="grid" id="grid"></div>
    </div>

    <div class="controls">
        <button class="btn btn-auto" id="auto-btn" onclick="toggleAutoCall()">▶️ ራስ-ሰር ጥሪ</button>
        <button class="btn btn-new" onclick="startNewGame()">🔄 አዲስ ካርድ</button>
        <button class="btn btn-bingo" onclick="claimBingo()">🏆 ቢንጎ! (BINGO)</button>
    </div>

    <!-- ብር ማስገቢያ መስኮት (Deposit Modal) -->
    <div class="modal" id="deposit-modal">
        <div class="modal-box">
            <h3>💳 ብር አስገባ (Telebirr / CBE)</h3>
            <p>የሚያስገቡትን የብር መጠን ይጻፉ (ዝቅተኛው 20 ብር)</p>
            <input type="number" id="dep-amount" placeholder="ለምሳሌ: 100" min="20">
            <div class="modal-btns">
                <button class="btn btn-new" onclick="closeModals()">ዝጋ</button>
                <button class="btn btn-dep" onclick="submitDeposit()">ቀጥል</button>
            </div>
        </div>
    </div>

    <!-- ብር ማውጫ መስኮት (Withdraw Modal) -->
    <div class="modal" id="withdraw-modal">
        <div class="modal-box">
            <h3>🏦 ብር አውጣ</h3>
            <select id="with-method">
                <option value="Telebirr">ቴሌብር (Telebirr)</option>
                <option value="CBE Birr">ሲቢኢ ብር (CBE Birr)</option>
            </select>
            <input type="tel" id="with-phone" placeholder="ስልክ ቁጥር (09...)">
            <input type="number" id="with-amount" placeholder="የብር መጠን (ዝቅተኛ 50 ብር)">
            <div class="modal-btns">
                <button class="btn btn-new" onclick="closeModals()">ዝጋ</button>
                <button class="btn btn-with" onclick="submitWithdraw()">አውጣ</button>
            </div>
        </div>
    </div>

    <!-- መልዕክት ማሳያ መስኮት -->
    <div class="modal" id="msg-modal">
        <div class="modal-box">
            <h3 id="msg-title">መልዕክት</h3>
            <p id="msg-text"></p>
